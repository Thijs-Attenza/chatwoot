<p>Beste <%= @resource.name %>,</p>

<% account_user = @resource&.account_users&.first %>

<% if account_user&.inviter.present? && @resource.unconfirmed_email.blank? %>
  <p><%= account_user.inviter.name %>, van <%= account_user.account.name %>, heeft je uitgenodigd voor <%= global_config['BRAND_NAME'] || 'Chatwoot' %>.</p>
<% end %>

<% if @resource.confirmed? %>
  <p>Je kunt je <%= global_config['BRAND_NAME'] || 'Chatwoot' %> account activeren door op onderstaande link te klikken:</p>
<% else %>
  <% if account_user&.inviter.blank? %>
  <p>
    Welkom bij <%= global_config['BRAND_NAME'] || 'Chatwoot' %>!
  </p>
  <% end %>
  <p>Verifieer je account door op onderstaande link te klikken.</p>
<% end %>


<% if @resource.unconfirmed_email.present? %>
  <p><%= link_to 'Bevestig mijn account', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% elsif @resource.confirmed? %>
  <p><%= link_to 'Login op mijn account', frontend_url('auth/sign_in') %></p>
<% elsif account_user&.inviter.present? %>
  <p><%= link_to 'Bevestig mijn account', frontend_url('auth/password/edit', reset_password_token: @resource.send(:set_reset_password_token)) %></p>
<% else %>
  <p><%= link_to 'Bevestig mijn account', frontend_url('auth/confirmation', confirmation_token: @token) %></p>
<% end %>
